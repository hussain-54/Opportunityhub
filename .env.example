# Client (browser) — preferred names for FutureBridge / Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy aliases also accepted (Lovable / older Vercel projects):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Public site origin (canonicals, sitemap, Open Graph) — no trailing slash
# Use the current Vercel URL until a FutureBridge domain is approved:
NEXT_PUBLIC_SITE_URL=https://opportunityhub-iota.vercel.app

# Server (SSR — mirror client values; same aliases work at runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SITE_URL=https://opportunityhub-iota.vercel.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SITE_URL=https://opportunityhub-iota.vercel.app

# Optional: trusted server-only operations
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# After first sign-up, promote an account to admin in Supabase SQL editor:
# update public.profiles set role = 'admin' where email = 'your@email.com';
